---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="prose">
    <header class="post-header">
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
          </span>
        )}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && (
        <p class="lead">{post.data.description}</p>
      )}
      {post.data.originalUrl && (
        <p class="original-link">
          Originally published on <a href={post.data.originalUrl} target="_blank" rel="noopener noreferrer">external source ↗</a>
        </p>
      )}
    </header>

    <div class="content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/" class="back-link">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }
  .tags {
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    color: var(--text-muted);
  }
  h1 {
    font-size: 2.15rem;
    line-height: 1.25;
    margin: 0.5rem 0 1rem;
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .original-link {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: 0.5rem;
  }
  .content {
    margin-bottom: 3rem;
  }
  .post-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover {
    color: var(--text);
  }
</style>
