---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="prose">
    <header class="post-header">
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
          </div>
        )}
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.description && (
        <p class="lead">{post.data.description}</p>
      )}
      {post.data.originalUrl && (
        <p class="original-link">
          Originally published on <a href={post.data.originalUrl} target="_blank" rel="noopener noreferrer">external source ↗</a>
        </p>
      )}
    </header>

    <div class="content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/" class="back-link">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    width: 100%;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  time {
    white-space: nowrap;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
  }

  .tag {
    color: var(--text-muted);
  }

  .post-title {
    font-size: 2rem;
    line-height: 1.25;
    margin: 0.5rem 0 1rem;
    letter-spacing: -0.03em;
    word-break: break-word;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .original-link {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .content {
    margin-bottom: 3rem;
    width: 100%;
    overflow-x: hidden;
  }

  .post-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 1.65rem;
      line-height: 1.3;
    }
    .lead {
      font-size: 1.05rem;
    }
  }
</style>
